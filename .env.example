# ═══════════════════════════════════════════════════════════════
# kb-migrator 配置示例 —— 复制为 .env 并填入真实值。切勿提交 .env。
# ═══════════════════════════════════════════════════════════════

# ── 通用 ──────────────────────────────────────────────────────
KBM_LEDGER_DB=./data/ledger.db          # 迁移台账 SQLite 路径（正式环境可换 PostgreSQL DSN）
KBM_WORK_DIR=./data/work                # 抽取文件的本地缓存目录
KBM_TAXONOMY_FILE=./config/taxonomy.yaml
KBM_CONFIDENCE_THRESHOLD=0.7            # AI 分类自动归档阈值(0.7 召回优先/0.85 保守)，低于则进人工；needs_human_review=true 一律进人工

# ── Claude / Anthropic ───────────────────────────────────────
ANTHROPIC_API_KEY=                      # 官方长 key(sk-ant-…) 或中转网关 key(sk-…)
ANTHROPIC_BASE_URL=                     # 自建/中转网关地址；留空=官方端点。例: https://llm-gateway.example.com
KBM_CLAUDE_AUTH_STYLE=auto              # auto|bearer|apikey。auto: 配了网关且非 sk-ant- 走 Bearer
KBM_CLAUDE_MODEL=claude-sonnet-5        # 主力模型；疑难可切 claude-opus-4-8
KBM_CLAUDE_USE_BATCH=true               # 批量分类走 Message Batches API（输入输出各 5 折）

# ── 飞书（自建应用）──────────────────────────────────────────
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 建知识空间等操作需 user_access_token（OAuth）；以下为回调配置
FEISHU_REDIRECT_URI=http://localhost:8000/feishu/oauth/callback
FEISHU_WIKI_SPACE_ID=                   # 已建好的知识空间 id（阶段1产出后回填）
KBM_FEISHU_OAUTH_SCOPE=wiki:wiki drive:drive   # 用户授权 scope（按应用实际授予调整）
FEISHU_USER_ACCESS_TOKEN=               # 可手动注入 user_access_token（否则走 OAuth 落盘）
# bootstrap 产物（均在 data/ 下，已被 .gitignore 忽略）：
KBM_FEISHU_TARGETS_FILE=./data/feishu_targets.json          # 分类->token 映射
KBM_FEISHU_USER_TOKEN_FILE=./data/feishu_user_token.json    # OAuth 换取的 user token

# ── SharePoint / Microsoft Graph（client_credentials 应用权限）──
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# 需管理员授权应用权限：Sites.Read.All + Files.Read.All（或 Sites.Selected）

# ── 企业微信（微盘 WeDrive）──────────────────────────────────
WECOM_CORP_ID=
WECOM_WEDRIVE_SECRET=                   # 微盘应用 secret；服务器 IP 须加入可信 IP 白名单

# ── 企业微信群聊（会话内容存档 Finance API）──────────────────
WECOM_CHAT_ARCHIVE_SECRET=              # 会话存档 secret
WECOM_CHAT_PRIVATE_KEY_FILE=./secrets/wecom_chat_rsa.pem   # RSA 私钥，独立隔离托管

# ── 企业微信群聊治理（govern-chat：协作者映射 + 群名打标）──────
WECOM_APP_SECRET=                       # 应用 secret，用于 appchat 改名/发通知（仅对该应用自建服务群有效）
WECOM_FEISHU_USER_MAP=./secrets/wecom_feishu_user_map.json  # {企业微信userid: 飞书open_id} 映射，人工维护
